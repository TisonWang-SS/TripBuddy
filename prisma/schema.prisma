generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum SupportedCurrency {
  USD
  CNY
}

enum BookingBaselineType {
  cash
  points
  certificate
}

enum BrowserTaskKind {
  booking_price_check
  hotel_search
  account_booking_import
}

enum BrowserTaskStatus {
  pending
  running
  succeeded
  partial
  failed
}

enum PriceCheckStatus {
  running
  succeeded
  partial
  failed
}

enum PriceCheckTrigger {
  manual
  due_queue
}

enum CollectionMethod {
  manual
  browser_companion
}

enum SourceType {
  direct
  ota
  other
}

enum InventoryType {
  cash
  award
}

enum LoginState {
  not_required
  anonymous
  member
  unknown
}

enum RoomMatch {
  exact
  similar
  unknown
}

enum CancellationMatch {
  same_or_better
  worse
  unknown
}

enum InclusionStatus {
  yes
  no
  unknown
}

enum EligibilityStatus {
  eligible
  not_eligible
  unknown
}

enum PromotionApplicability {
  applies
  does_not_apply
  unknown
}

enum EvidenceQuality {
  high
  medium
  low
  needs_review
}

enum AssessmentSource {
  automated
  model
  user
}

enum ExtractionSource {
  deterministic
  model
  manual
}

enum EvidenceExtractionStatus {
  succeeded
  partial
  failed
}

enum RiskLevel {
  low
  medium
  high
}

enum RecommendationVerdict {
  keep
  rebook_direct
  consider_ota
  needs_review
  urgent
}

model SystemSetting {
  id              String                   @id @default("primary")
  displayCurrency SupportedCurrency        @default(USD)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  conversionRates CurrencyConversionRate[]
}

model CurrencyConversionRate {
  id              String            @id @default(cuid())
  systemSettingId String            @default("primary")
  sourceCurrency  String
  targetCurrency  SupportedCurrency
  rate            Float
  sourceName      String?
  asOf            DateTime
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  systemSetting   SystemSetting     @relation(fields: [systemSettingId], references: [id], onDelete: Cascade)

  @@unique([systemSettingId, sourceCurrency, targetCurrency])
}

model UserProfile {
  id                  String               @id @default(cuid())
  name                String               @default("Primary Traveler")
  defaultCurrency     SupportedCurrency    @default(USD)
  savingsThreshold    Float                @default(50)
  urgentWindowHours   Int                  @default(24)
  breakfastValue      Float                @default(25)
  loungeValue         Float                @default(35)
  lateCheckoutValue   Float                @default(15)
  upgradeValue        Float                @default(40)
  eliteNightValue     Float                @default(10)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  loyaltyAccounts     LoyaltyAccount[]
  creditCardBenefits  CreditCardBenefit[]
  hotelSearchSessions HotelSearchSession[]
}

model LoyaltyAccount {
  id            String      @id @default(cuid())
  profileId     String
  hotelGroup    String
  tier          String
  currentNights Int         @default(0)
  currentPoints Int         @default(0)
  currentSpend  Float       @default(0)
  targetTier    String?
  pointValue    Float       @default(0.005)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  profile       UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, hotelGroup])
}

model CreditCardBenefit {
  id                String      @id @default(cuid())
  profileId         String
  name              String
  hotelGroup        String?
  cashBackRate      Float       @default(0)
  pointMultiplier   Float       @default(0)
  eliteNightCredits Int         @default(0)
  notes             String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  profile           UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model HotelBooking {
  id                   String              @id @default(cuid())
  hotelGroup           String
  hotelName            String
  city                 String
  /// Calendar date stored as UTC midnight; read using UTC date components.
  checkIn              DateTime
  /// Calendar date stored as UTC midnight; read using UTC date components.
  checkOut             DateTime
  guests               Int                 @default(1)
  roomType             String
  isSuite              Boolean             @default(false)
  baselineType         BookingBaselineType @default(cash)
  baselineCashTotal    Float?
  baselinePoints       Int?
  baselineAwardLabel   String?
  currency             SupportedCurrency   @default(USD)
  bookingChannel       SourceType          @default(direct)
  /// Local wall-clock deadline stored as an instant; read using the user's local timezone.
  cancellationDeadline DateTime?
  breakfastIncluded    Boolean             @default(false)
  loyaltyEligible      Boolean             @default(true)
  bookingUrl           String?
  notes                String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  watchPlan            WatchPlan?
  priceCheckRuns       PriceCheckRun[]
  observations         PriceObservation[]
  recommendations      Recommendation[]
}

model WatchPlan {
  id                  String          @id @default(cuid())
  bookingId           String          @unique
  enabled             Boolean         @default(true)
  cashEnabled         Boolean         @default(true)
  awardEnabled        Boolean         @default(true)
  normalCadenceHours  Int             @default(24)
  urgentCadenceHours  Int             @default(6)
  urgentWindowHours   Int             @default(72)
  lastCheckedAt       DateTime?
  lastAttemptedAt     DateTime?
  consecutiveFailures Int             @default(0)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  booking             HotelBooking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  priceCheckRuns      PriceCheckRun[]
}

model BrowserTask {
  id            String            @id @default(cuid())
  kind          BrowserTaskKind
  hotelGroup    String
  status        BrowserTaskStatus @default(pending)
  launchUrl     String
  contextJson   String
  snapshotsJson String            @default("[]")
  resultJson    String?
  errorCode     String?
  errorMessage  String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  expiresAt     DateTime
  finishedAt    DateTime?
  priceCheckRun PriceCheckRun?

  @@index([status, expiresAt])
}

model HotelSearchSession {
  id          String      @id @default(cuid())
  profileId   String      @default("primary")
  queryJson   String
  resultsJson String      @default("{\"hotels\":[]}")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  expiresAt   DateTime
  profile     UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, createdAt])
  @@index([expiresAt])
}

model PriceCheckRun {
  id                    String             @id @default(cuid())
  bookingId             String
  watchPlanId           String?
  browserTaskId         String             @unique
  startedAt             DateTime           @default(now())
  finishedAt            DateTime?
  expiresAt             DateTime
  status                PriceCheckStatus   @default(running)
  trigger               PriceCheckTrigger
  inventoryTypesJson    String
  providerName          String
  sourceUrl             String?
  summary               String?
  errorCode             String?
  errorMessage          String?
  inventoryEvidenceJson String             @default("[]")
  booking               HotelBooking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  watchPlan             WatchPlan?         @relation(fields: [watchPlanId], references: [id], onDelete: SetNull)
  browserTask           BrowserTask        @relation(fields: [browserTaskId], references: [id], onDelete: Cascade)
  observations          PriceObservation[]
  extractionRuns        EvidenceExtractionRun[]

  @@index([bookingId, startedAt])
  @@index([status, expiresAt])
}

model PriceObservation {
  id                    String               @id @default(cuid())
  bookingId             String
  priceCheckRunId       String?
  observedAt            DateTime             @default(now())
  collectionMethod      CollectionMethod     @default(manual)
  sourceName            String
  sourceType            SourceType
  providerName          String?
  inventoryType         InventoryType        @default(cash)
  cashBase              Float?
  cashTaxes             Float?
  cashFees              Float?
  cashTotal             Float?
  cashCurrency          String?
  points                Int?
  cashCopay             Float?
  cashCopayCurrency     String?
  rawRateName           String?
  ratePlanName          String?
  roomTypeRaw           String?
  isSuite               Boolean?
  cancellationPolicyRaw String?
  breakfastIncluded     Boolean?
  loyaltyEligible       Boolean?
  sourceUrl             String?
  notes                 String?
  extractionSource      ExtractionSource   @default(manual)
  extractorName         String             @default("manual-form")
  extractorVersion      String             @default("1")
  extractionRunId       String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  booking               HotelBooking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  priceCheckRun         PriceCheckRun?       @relation(fields: [priceCheckRunId], references: [id], onDelete: SetNull)
  extractionRun         EvidenceExtractionRun? @relation(fields: [extractionRunId], references: [id], onDelete: SetNull)
  evidence              ObservationEvidence?
  recommendations       Recommendation[]     @relation("RecommendationCandidate")

  @@index([bookingId, observedAt])
  @@index([extractionRunId])
}

model EvidenceExtractionRun {
  id                     String                   @id @default(cuid())
  priceCheckRunId        String
  extractorName          String
  extractorVersion       String
  modelName               String
  status                  EvidenceExtractionStatus
  snapshotCount           Int
  proposedCandidatesJson String                   @default("[]")
  acceptedCandidatesJson String                   @default("[]")
  issuesJson              String                   @default("[]")
  createdAt               DateTime                 @default(now())
  priceCheckRun           PriceCheckRun            @relation(fields: [priceCheckRunId], references: [id], onDelete: Cascade)
  observations            PriceObservation[]

  @@index([priceCheckRunId, createdAt])
}

model ObservationEvidence {
  id                           String                 @id @default(cuid())
  observationId                String                 @unique
  sourceVerified               Boolean                @default(false)
  loginState                   LoginState             @default(unknown)
  roomMatch                    RoomMatch              @default(unknown)
  roomMatchReason              String
  roomAssessmentSource         AssessmentSource       @default(automated)
  cancellationMatch            CancellationMatch      @default(unknown)
  cancellationMatchReason      String
  cancellationAssessmentSource AssessmentSource       @default(automated)
  taxesIncluded                InclusionStatus        @default(unknown)
  feesIncluded                 InclusionStatus        @default(unknown)
  loyaltyEligibility           EligibilityStatus      @default(unknown)
  promotionApplicability       PromotionApplicability @default(unknown)
  currencyComparable           Boolean                @default(false)
  qualityLevel                 EvidenceQuality
  blockersJson                 String                 @default("[]")
  warningsJson                 String                 @default("[]")
  snapshotJson                 String                 @default("{}")
  reviewedAt                   DateTime?
  createdAt                    DateTime               @default(now())
  updatedAt                    DateTime               @updatedAt
  observation                  PriceObservation       @relation(fields: [observationId], references: [id], onDelete: Cascade)
}

model Promotion {
  id                        String    @id @default(cuid())
  hotelGroup                String
  title                     String
  description               String?
  /// Calendar date stored as UTC midnight; read using UTC date components.
  startDate                 DateTime?
  /// Calendar date stored as UTC midnight; read using UTC date components.
  endDate                   DateTime?
  bonusMultiplier           Float     @default(0)
  flatValue                 Float     @default(0)
  requiresRegistration      Boolean   @default(false)
  appliesToExistingBookings Boolean   @default(false)
  sourceUrl                 String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
}

model Recommendation {
  id                        String                @id @default(cuid())
  bookingId                 String
  candidateObservationId    String?
  generatedAt               DateTime              @default(now())
  verdict                   RecommendationVerdict
  riskLevel                 RiskLevel
  qualityLevel              EvidenceQuality
  estimatedSavings          Float
  currency                  SupportedCurrency
  cashDifference            Float
  pointsValueDifference     Float
  promotionValueDifference  Float
  creditCardValueDifference Float
  eliteProgressDifference   Float
  benefitValueDifference    Float
  explanation               String
  blockersJson              String                @default("[]")
  warningsJson              String                @default("[]")
  costBreakdownJson         String
  decisionProvider          String
  decisionVersion           String
  booking                   HotelBooking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  candidateObservation      PriceObservation?     @relation("RecommendationCandidate", fields: [candidateObservationId], references: [id], onDelete: SetNull)

  @@index([bookingId, generatedAt])
}

model LoyaltyRule {
  id                  String   @id @default(cuid())
  hotelGroup          String
  tier                String
  nightsRequired      Int?
  pointsRequired      Int?
  spendRequired       Float?
  basePointsPerUsd    Float
  bonusRate           Float
  breakfastBenefit    Boolean  @default(false)
  loungeBenefit       Boolean  @default(false)
  lateCheckoutBenefit Boolean  @default(false)
  upgradeBenefit      Boolean  @default(false)
  sourceUrl           String
  lastReviewedAt      DateTime

  @@unique([hotelGroup, tier])
}
