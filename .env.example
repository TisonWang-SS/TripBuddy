DATABASE_URL="file:../data/tripbuddy.db"
# Only needed to reach the app at a host that is neither loopback nor a private
# IPv4 address, such as an mDNS name like http://tripbuddy.local:3000
TRIPBUDDY_APP_ORIGIN=""
TRIPBUDDY_BROWSER_EXTENSION_ORIGIN=""
TRIPBUDDY_LLM_API_KEY=""
TRIPBUDDY_LLM_BASE_URL="https://api.deepseek.com"
TRIPBUDDY_LLM_MODEL="deepseek-v4-flash"
# Optional RollingGo Global OTA comparison. When the Global skill is logged in,
# TripBuddy reads ~/.hotel-global-cli/token.json automatically.
# ROLLINGGO_GLOBAL_TOKEN_PATH="/absolute/path/to/token.json"
# ROLLINGGO_GLOBAL_MCP_BASE_URL="https://mcp.rollinggo.ai/mcp"
# ROLLINGGO_GLOBAL_COUNTRY_CODE="US"
# ROLLINGGO_GLOBAL_TIMEOUT_MS="15000"
